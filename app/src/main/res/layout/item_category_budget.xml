<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="14dp"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvCbEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/tvCbName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"/>

        <TextView
            android:id="@+id/tvCbAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12.5sp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvCbSet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:minHeight="32dp"
            android:gravity="center"
            android:textColor="@color/brand_primary"
            android:textStyle="bold"
            android:textSize="12.5sp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/flCbTrack"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:visibility="gone">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_progress_track"/>
        <View
            android:id="@+id/vCbFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@drawable/bg_progress_fill"/>
    </FrameLayout>
</LinearLayout>
