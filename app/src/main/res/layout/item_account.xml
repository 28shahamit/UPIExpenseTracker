<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:id="@+id/rowTop" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground">
        <TextView android:id="@+id/tvAccIcon" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:textSize="22sp" android:background="@drawable/bg_circle"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:id="@+id/tvAccName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/on_surface" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/tvAccDefaultChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/bg_chip" android:backgroundTint="@color/status_success_bg" android:text="Default" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/status_success" android:visibility="gone"/>
            </LinearLayout>
            <TextView android:id="@+id/tvAccSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/on_surface_secondary"/>
            <TextView android:id="@+id/tvAccUpi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/on_surface_secondary" android:visibility="gone"/>
        </LinearLayout>
        <TextView android:id="@+id/tvAccBalance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/on_surface"/>
        <TextView android:id="@+id/tvAccChevron" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="\u22EE" android:textSize="22sp" android:textStyle="bold" android:paddingStart="10dp" android:paddingEnd="2dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:clickable="true" android:focusable="true" android:textColor="@color/on_surface_secondary"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/rowActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical">
        <TextView android:id="@+id/btnSetDefault" android:layout_width="wrap_content" android:layout_weight="0" android:layout_height="34dp" android:layout_marginEnd="6dp" android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="Set Default" android:textSize="11.5sp" android:textColor="@color/brand_primary" android:singleLine="true" android:background="@drawable/bg_tab_chip" android:backgroundTint="#FFFFFF" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/btnTransfer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp" android:layout_marginEnd="6dp" android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="Transfer" android:textSize="11.5sp" android:textColor="#1A56DB" android:singleLine="true" android:background="@drawable/bg_tab_chip" android:backgroundTint="#E8F0FE" android:clickable="true" android:focusable="true" android:drawableStart="@drawable/ic_transfer" android:drawableTint="#1A56DB" android:drawablePadding="4dp"/>
        <TextView android:id="@+id/btnAdjust" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp" android:layout_marginEnd="6dp" android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="Adjust" android:textSize="11.5sp" android:textColor="@color/brand_primary" android:singleLine="true" android:background="@drawable/bg_tab_chip" android:backgroundTint="@color/brand_primary_light" android:clickable="true" android:focusable="true" android:drawableStart="@drawable/ic_adjust" android:drawableTint="@color/brand_primary" android:drawablePadding="4dp"/>
        <TextView android:id="@+id/btnStatement" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp" android:layout_marginEnd="6dp" android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="Statement" android:textSize="11.5sp" android:textColor="#1A56DB" android:singleLine="true" android:background="@drawable/bg_tab_chip" android:backgroundTint="#E8F0FE" android:clickable="true" android:focusable="true" android:drawableStart="@drawable/ic_statement" android:drawableTint="#1A56DB" android:drawablePadding="4dp"/>
        <TextView android:id="@+id/btnAccMenu" android:layout_width="30dp" android:layout_height="34dp" android:gravity="center" android:text="\u22EE" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/on_surface_secondary" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</LinearLayout>
